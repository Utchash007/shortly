# Shortly environment template. Copy to `.env` (never committed) or paste the
# key=value pairs into Render Dashboard -> Environment -> Environment Variables.
#
# Alternatively mount this file as a Render Secret File: the app loads it
# automatically from DOTENV_PATH, ./.env, or /etc/secrets/.env (dashboard
# variables always win over the file).
#
# Legacy shorthands `jdbc` and `redis_conn` are translated automatically and
# may be used instead of the SPRING_* datasource/redis entries.

SPRING_PROFILES_ACTIVE=dev

# Supabase (pooler string from Dashboard -> Connect -> Session pooler):
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=

# Redis (managed instance or local `docker compose up -d`):
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# Public host baked into shortUrl and QR codes:
APP_BASE_URL=http://localhost:8080

# Optional: explicit path to the file (Render secret mount lives here by default):
# DOTENV_PATH=/etc/secrets/.env
